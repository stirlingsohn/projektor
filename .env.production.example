# Vorlage für die .env auf dem Server (cyon). Die echte .env liegt nur dort.
APP_NAME=Projektor
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/Zurich
APP_URL=https://projektor.stirlingtschan.ch

APP_LOCALE=de_CH
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_CH

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=jifetaje_projektor
DB_USERNAME=jifetaje_claude
# Selbst eintragen, nicht ins Repository!
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAX_UPLOAD_MB=100

# cyon stellt Mails des eigenen Servers über sendmail zu.
MAIL_MAILER=sendmail
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
MAIL_FROM_ADDRESS="projektor@stirlingtschan.ch"
MAIL_FROM_NAME="${APP_NAME}"
